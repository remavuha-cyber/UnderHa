# Логин и пароль для входа в панель PhoneFarm.
PANEL_USER=admin
PANEL_PASSWORD=поменяйте-на-длинный-пароль

# Максимальный размер одного видео, МБ.
MAX_UPLOAD_MB=4096

# Если есть домен (например, myfarm.duckdns.org), укажите его и запускайте
# с --profile https: панель будет на https://ваш-домен с бесплатным сертификатом.
PANEL_DOMAIN=

# С доменом поставьте 127.0.0.1, чтобы панель не была видна по голому http://IP:8080.
PANEL_BIND=0.0.0.0
